# ── REQUIRED (same in both modes) ─────────────────────────
TELEGRAM_BOT_TOKEN=your_bot_token_here
ADMIN_ID=your_telegram_numeric_user_id
BACKUP_CHANNEL=your_backup_channel_id

# ── VERCEL MODE (state + webhook) ────────────────────────
# Apne ek Firebase Realtime Database project ka URL daalo
# jiska Realtime Database enabled ho (not Firestore).
# Yahan bot apna state save karega jo redeploys ke baad bhi bachega.
BOT_DB_URL=https://your-project-default-rtdb.firebaseio.com
# (optional) Default path inside that Firebase
BOT_DB_PATH=your-state-path

# ── VPS MODE (state + polling) ───────────────────────────
# Local state file (VPS/VM par chalate ho to sirf ye chahiye,
# BOT_DB_URL mat do)
# STATE_FILE=/home/user/auto-token-sender/data/state.json

# Vercel deploy hone par auto webhook set hoga.
# Agar manually webhook lagana hai to ye batao:
# WEBHOOK_URL=https://your-project.vercel.app
